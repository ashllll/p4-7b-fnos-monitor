diff --git a/components/fnos_monitor/fnos_data.c b/components/fnos_monitor/fnos_data.c
index c8417f1..29837f5 100644
--- a/components/fnos_monitor/fnos_data.c
+++ b/components/fnos_monitor/fnos_data.c
@@ -68,6 +68,13 @@ static SemaphoreHandle_t s_lock;
 static TaskHandle_t s_task;
