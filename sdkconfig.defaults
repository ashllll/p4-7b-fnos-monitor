CONFIG_IDF_TARGET="esp32p4"
# CONFIG_ESP32P4_SELECTS_REV_LESS_V3 is not set
CONFIG_ESP32P4_REV_MIN_300=y
# 注意：本机 PlatformIO 的 ESP-IDF 包（framework-espidf@3.50503.0）里
# components/fatfs/src/ffconf.h 与 Kconfig 的默认值不匹配：
#   - FF_FS_EXFAT 被本地改成 1（注释 "local mod for ESP32-C6-LCD-1.47"），exFAT 要求 LFN 打开；
#   - FF_USE_LABEL / FF_USE_DYN_BUFFER 直接展开成 CONFIG_FATFS_USE_LABEL /
#     CONFIG_FATFS_USE_DYN_BUFFERS，而这两个 bool 默认是 n（n 的项不会写进 sdkconfig.h），
#     于是 ff.c 编译报 "CONFIG_... undeclared"。
# 本机另一个能编译过的工程（ESP32-C6-LCD-1.47）正是把这三项都打开的，这里照做。
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_FATFS_USE_DYN_BUFFERS=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL=2
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# 关掉 LVGL 内部日志：每次 lv_refr / indev 都会走 printf 格式化，手势帧上的
# 固定开销。调试时再本地改回 y。
CONFIG_LV_USE_LOG=n
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
# 7 寸屏重排后的大字号（Traffic/Overview 的主数值）
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_BUILD_EXAMPLES=n
# 官方示例原本写的是 2 —— 但 main.cpp 用的是
# ESP_LV_ADAPTER_TEAR_AVOID_MODE_DOUBLE_DIRECT，esp_lvgl_adapter 会向 DPI 面板
# 申请 3 个 frame buffer；BSP 只给 2 个时请求失败（err=258），随后 LVGL 在
# DIRECT 模式断言（lv_display_set_cbuffers: stride*h <= buf_size）并卡死在
# app_main → 看门狗反复打印 IDLE0 饥饿。BSP 的 Kconfig 默认值是 3，这里显式写 3。
# （官方 11_esp_brookesia_phone 示例自带的 2 在真机上起不来，其 README 也承认
#   CI 只验证编译、运行时行为需真机验证。）
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
# TLS 缓冲默认吃内部 RAM —— 本板内部 RAM 还要养 LVGL/显示/ESP-Hosted(SDIO)：
# 实测跑约 170 秒后内部 DMA 内存耗尽（esp-aes 分配 DMA 描述符失败 → mbedtls 握手
# 失败 → 所有 GET 失败），紧接着 LVGL 任务卡死（界面冻结 + 触摸失效）。
# 上游 T-Display-S3 工程本来就开了下面两项，移植时漏掉了。
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ── 内部 RAM 搬运（2026-09-19）──────────────────────────────────────────────
# 本板内部 RAM 只有 ~361 KB 可用（启动后进动态堆的部分），还要养 LVGL/DSI/
# ESP-Hosted/WiFi/任务栈；PSRAM 32 MB 却只用了 3.6 MB 帧缓冲。下面三项把
# 能搬的都搬到 PSRAM，腾出的内部 RAM 是留给摄像头/音频/视频/多 app 的。
#
# 1) LVGL 对象/样式/缓存 → PSRAM（实现见 components/lvgl_mem_psram/）
CONFIG_LV_USE_CUSTOM_MALLOC=y
# 2) 允许任务栈放外部内存（PSRAM）
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# 3) LVGL 内部线程栈（含 v9 绘制线程）放 PSRAM
CONFIG_ESP_LVGL_ADAPTER_LVGL_THREAD_STACK_IN_PSRAM=y
# 4) 允许把 .bss 段放进 PSRAM：本工程的大块数据（状态快照 ~2.4KB、曲线环形缓冲
#    ~9.6KB）用 EXT_RAM_BSS_ATTR 标注，没这一项这些变量会落回内部 RAM
#    （EXT_RAM_BSS_ATTR 在未开启时展开为空，静默失效）。
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# 说明：LVGL 绘制缓冲（更早那 ~142 KB 大头）由工程内 BSP 副本的
# .use_psram = true 负责，见 components/esp32_p4_wifi6_touch_lcd_7b/
# ── fnOS 监视器 ─────────────────────────────────────────────────────────────
# 曲线窗口（秒）= LVGL 图表点数；点数越多重绘越贵，180 秒在 1024x600 上够看趋势
CONFIG_FNOS_CHART_WINDOW=180
# 串口每 10 秒打印一次堆余量（排查"跑一段时间后界面冻结"时打开）
CONFIG_FNOS_HEAP_DEBUG=n
# 主任务栈 3584 → 16 KB（2026-10-05 修）：app_main 里的 fnos_ui_create() 要建
# 四个页面 + 配对整页卡（含数字键盘），LVGL 建构件那条调用链（lv_obj_create →
# lv_malloc → heap_caps_aligned_alloc）本身就要吃掉几 KB 栈；用 3584 字节的默认值
# 会在 fnos_ui_create 里直接撞栈保护：Core 0 panic'ed (Stack protection fault)，
# 设备每 4.6 秒重启一次。LVGL 自己的任务栈本来就配了 12 KB，主任务对齐它。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384


CONFIG_FNOS_PALETTE="device"
