[Unit]
Description=fnOS read-only status agent (JSON over HTTP, for ESP32 dashboard)
Documentation=https://github.com/ashllll
After=network-online.target docker.service
Wants=network-online.target
# docker.sock 只用于读取容器状态；docker 没起来也要能提供服务
After=docker.socket

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/bin/fnos-agent.py --bind 0.0.0.0 --port 8799 --interval 1.0
Restart=always
RestartSec=3
Nice=5
CPUQuota=25%
MemoryMax=192M

# ── 只读加固：这个服务不需要写任何东西 ───────────────────────────────
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=false
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
