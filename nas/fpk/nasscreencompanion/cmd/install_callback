#!/bin/bash
. "$(dirname "$0")/_common.sh"
# 安装后：把向导里的选择落成 config.json。
say "写入配置"
prepare_package_data || exit 1
as_package mkdir -p "$PKG_VAR" "$PKG_ETC" 2>/dev/null || {
  fail "无法创建应用数据目录"
  exit 1
}

PY=$(resolve_python) || { fail "找不到 Python 运行时，无法写入配置"; exit 1; }
norm_wizard
# fnOS may also run installation callbacks while replacing an existing package.
# Only a fresh install uses wizard defaults; configuration changes have their own callback.
if [ -e "$PKG_VAR/config.json" ]; then
  say "保留已有配置；服务设置可在管理页或应用设置中修改"
elif cfg_out=$(apply_config "$PY" "$W_PORT" "$W_BIND" "$W_AUTH" "$W_DOCKER" "$W_INTERVAL" "$W_TLS" 2>&1); then
  say "配置已写入 $PKG_VAR/config.json"
  if [ -n "$cfg_out" ]; then say "$cfg_out"; fi
else
  # 把真实原因带出来（审计 M53）：config.json 损坏、目录只读、磁盘满都会走这里，
  # 以前一律说"请检查写权限"，把排查方向指错了。
  fail "配置写入失败：${cfg_out:-未知原因}"
  exit 1
fi

say "安装完成。请在飞牛桌面的应用入口打开「飞牛监控」查看能力矩阵并配对开发板。"
exit 0
