#!/bin/bash
. "$(dirname "$0")/_common.sh"
# 升级后：补齐新版本新增的配置项（保留设备令牌），再按升级前的状态决定是否启动。
say "升级后处理 ${TRIM_OLD_APPVER:-?} -> ${TRIM_APPVER:-?}"
prepare_package_data || exit 1
as_package mkdir -p "$PKG_VAR" "$PKG_ETC" 2>/dev/null || { fail "无法准备升级数据目录"; exit 1; }
FLAG="$PKG_VAR/upgrade.was_running"
if [ -L "$FLAG" ] || { [ -e "$FLAG" ] && [ ! -f "$FLAG" ]; }; then
  fail "升级恢复标志不是普通文件"; exit 1
fi

PY=$(resolve_python) || { fail "找不到 Python 运行时，无法整理配置"; exit 1; }

as_package "$PY" - "$PKG_VAR/config.json" <<'PYEOF'
import json, os, sys, tempfile, fcntl, stat
path = sys.argv[1]
defaults = {"bind": "0.0.0.0", "port": 8798, "interval": 1.0, "hist_len": 300,
            "docker_enabled": False, "auth_mode": "pairing", "devices": []}
os.makedirs(os.path.dirname(path), exist_ok=True)
lock_fd = os.open(path + ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
with os.fdopen(lock_fd, "a") as lock:
    if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
        raise ValueError("配置锁不是普通文件")
    fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
    cfg = {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            cfg = json.load(f)
    except FileNotFoundError:
        pass
    if not isinstance(cfg, dict):
        raise ValueError("config.json 必须是 JSON 对象，原文件未修改")
    added = [k for k in defaults if k not in cfg]
    for k, v in defaults.items():
        cfg.setdefault(k, v)
    if not isinstance(cfg.get("devices"), list):
        cfg["devices"] = []
    revision = cfg.get("_revision", 0)
    if type(revision) is not int or revision < 0:
        raise ValueError("配置修订号非法")
    cfg["_revision"] = revision + 1
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".config-", suffix=".tmp", dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            fd = None
            json.dump(cfg, f, ensure_ascii=False, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    finally:
        if fd is not None:
            os.close(fd)
        try:
            os.unlink(tmp)
        except FileNotFoundError:
            pass

    print("配置补齐完成，新增字段：%s；保留已配对设备 %d 个"
          % (", ".join(added) or "无", len(cfg["devices"])))
PYEOF
if [ $? -ne 0 ]; then
  fail "配置读取或补齐失败，已保留原文件；请检查 $PKG_VAR/config.json 后重试"
  exit 1
fi

if [ -f "$FLAG" ]; then
  say "升级前服务处于运行状态，重新启动"
  service_start || { fail "升级后启动失败，已保留恢复标志，请看 $PKG_VAR/info.log"; exit 1; }
  as_package rm -f "$FLAG" || { fail "服务已恢复，但无法清除升级标志，请重试"; exit 1; }
else
  say "升级前服务未运行，保持停止状态"
fi
exit 0
