menu "fnOS monitor"

    config FNOS_HEAP_DEBUG
        bool "打印堆余量与任务状态（每 10 秒）"
        default n
        help
            打开后每 10 秒在串口打印内部 RAM / DMA / PSRAM 余量、LVGL 任务状态、
            轮询统计。排查"界面冻结""内存下滑"时打开它比猜快得多。

    config FNOS_AUTO_PAGE_SEC
        int "自动轮播页面间隔（秒，0=关闭）"
        range 0 120
        default 0
        help
            只用于视觉验收：打开后每 N 秒自动切到下一页，方便用摄像头逐页拍照核对。
            平时保持 0，交给你自己点导航/滑动翻页。

    config FNOS_PALETTE
        string "配色方案（graphite / abyss / phosphor）"
        default "graphite"
        help
            预置配色见 components/fnos_monitor/kk_ui/kk_theme.c：
              graphite  中性石墨蓝灰（最素，默认）
              abyss     深空蓝 + 青，像网络运维终端
              phosphor  近黑 + 磷光绿，对比度最高
            配色只管颜色：版面几何全在 kk_layout.h，与配色无关 —— 换配色不会挪动
            任何一个元素。名字写错会退回 graphite（设备照样能开机）。

    config FNOS_CHART_WINDOW
        int "曲线窗口（秒，1 Hz 采样点数）"
        range 60 600
        default 180
        help
            网络/CPU 曲线在屏幕上保留的秒数。点数越多内存与重绘开销越大。

endmenu
