diff --git a/nas/fpk/nasscreencompanion/app/server/docker_api.py b/nas/fpk/nasscreencompanion/app/server/docker_api.py
new file mode 100644
index 0000000..ec6f15a
--- /dev/null
+++ b/nas/fpk/nasscreencompanion/app/server/docker_api.py
@@ -0,0 +1,93 @@
+"""Bounded read-only Docker transport, direct in tests or through the inherited reader FD."""
+import http.client
+import json
+import os
+import socket
+import struct
+import threading
+import time
+
+MAX_RESPONSE = 4 * 1024 * 1024
+MAX_FRAME = 256 * 1024
+_lock = threading.Lock()
+_reader = None
+_broken = False
+
+
+def _reap_reader():
+    global _broken
+    try:
+        os.waitpid(int(os.environ['NSC_DOCKER_READER_PID']), 0)
+    except ChildProcessError:
+        return
+    with _lock:
+        _broken = True
+        if _reader is not None:
+            _reader.close()
+
+
+# Reap this specific child without changing SIGCHLD semantics for TLS subprocesses.
+if os.environ.get('NSC_DOCKER_READER_PID'):
