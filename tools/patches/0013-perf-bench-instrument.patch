+void fnos_perf_init(void);                 // 幂等；在 LVGL 任务里、持有显示锁时调
+void fnos_perf_note_tick(uint32_t us);     // ui_tick 一次的总耗时
+bool fnos_perf_cli(char *line);            // 串口命令 hook；没认出来返回 false
