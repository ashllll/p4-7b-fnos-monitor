+    for (int i = 0; i < s_tgrp_n; i++) { lv_free(s_tgrp[i].name); s_tgrp[i].name = NULL; }
+    s_tgrp_n = 0; /* Old dev pointers belong to the previous snapshot. */
+    if (n > s_tgrp_capacity) {
