+        g->first = i;
+        g->hot   = i;
+        g->max_c = st->temps[i].c;
+        int j = i;
+        while (j < n) {
+            const char *d = st->temps[j].dev[0] ? st->temps[j].dev : st->temps[j].ch;
+            if (strcmp(d, g->dev) != 0) break;
+            if (st->temps[j].c > g->max_c) { g->max_c = st->temps[j].c; g->hot = j; }
+            j++;
+        }
+        g->count = j - i;
+        g->min_c  = g->max_c;
+        for (int k = i; k < j; k++) {
+            if (st->temps[k].c < g->min_c) g->min_c = st->temps[k].c;
