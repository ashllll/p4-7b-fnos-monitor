-    lv_obj_remove_flag(box, LV_OBJ_FLAG_CLICKABLE);
-    uint32_t c = lv_color_to_u32(color);
-    switch (kind) {
-    case KK_ICON_OVERVIEW:                       // 表盘：270° 环 + 中心点
-        {
-            lv_obj_t *a = lv_arc_create(box);
