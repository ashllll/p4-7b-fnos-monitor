+/* 分组：temps[] 已按 (dev, ch) 排好（fnos_data.c 的 temp_cmp），同设备必然相邻。
+   dn 重名（同型号多块盘）时把 dev 附上 —— 否则用户看到的是"N 份一模一样的行"。 */
+static bool temp_groups(void)
+{
+    const fnos_status_t *st = &s_st;
