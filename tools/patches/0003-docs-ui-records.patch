+      ...fitOut,
+      ...(defects.length + fitOut.length > 0 && notes.length ? ["---"] : []),
+      ...notes,
+      ...(pools.length ? ["=== pools ==="] : []),
+      ...pools,
+      ...(geo.length ? ["=== geo ==="] : []),
